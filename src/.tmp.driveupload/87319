from pathlib import Path
import cv2
import numpy as np
import torch
from PIL import Image

from config import IDX_TO_CLASS, MODEL_DIR
from dataset import get_transforms
from model_transfer import MaskResNet18


def get_haar_cascade() -> cv2.CascadeClassifier:
    """Loads Haar Cascade using direct path resolution for headless environments."""
    cascade_path = cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    
    if not Path(cascade_path).exists():
        raise FileNotFoundError(f"Haar Cascade file not found at {cascade_path}")

    # Fallback initialization using cv2.objdetect if standard namespace fails
    if hasattr(cv2, "CascadeClassifier"):
        face_cascade = cv2.CascadeClassifier(cascade_path)
    elif hasattr(cv2, "objdetect") and hasattr(cv2.objdetect, "CascadeClassifier"):
        face_cascade = cv2.objdetect.CascadeClassifier(cascade_path)
    else:
        raise AttributeError("CascadeClassifier unavailable in current OpenCV installation.")

    if face_cascade.empty():
        raise RuntimeError("Failed to load Haar Cascade xml file.")
        
    return face_cascade


def process_frame(
    frame: np.ndarray,
    model: torch.nn.Module,
    face_cascade: cv2.CascadeClassifier,
    eval_transform: callable,
    device: torch.device,
    threshold: float = 0.19,
) -> np.ndarray:
    """Detects faces and predicts mask status on a single frame."""
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(
        gray, scaleFactor=1.1, minNeighbors=5, minSize=(60, 60)
    )

    for (x, y, w, h) in faces:
        face_roi = frame[y : y + h, x : x + w]
        face_rgb = cv2.cvtColor(face_roi, cv2.COLOR_BGR2RGB)
        pil_img = Image.fromarray(face_rgb)

        tensor = eval_transform(pil_img).unsqueeze(0).to(device)

        with torch.no_grad():
            logits = model(tensor)
            prob_no_mask = torch.sigmoid(logits).squeeze().item()

        is_no_mask = prob_no_mask >= threshold
        label = "No Mask" if is_no_mask else "Mask"
        conf = prob_no_mask if is_no_mask else (1.0 - prob_no_mask)

        color = (0, 0, 255) if is_no_mask else (0, 255, 0)

        cv2.rectangle(frame, (x, y), (x + w, y + h), color, 2)
        cv2.putText(
            frame,
            f"{label} ({conf * 100:.1f}%)",
            (x, max(y - 10, 15)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            color,
            2,
        )

    return frame


def run_face_mask_detector(threshold: float = 0.19) -> None:
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    checkpoint_path = MODEL_DIR / "resnet18_best.pth"

    if not checkpoint_path.exists():
        raise FileNotFoundError(f"Model checkpoint missing at {checkpoint_path}")

    # Load Model
    model = MaskResNet18(dropout_rate=0.3).to(device)
    checkpoint = torch.load(checkpoint_path, map_location=device)
    model.load_state_dict(checkpoint["model_state_dict"])
    model.eval()

    _, eval_transform = get_transforms()
    face_cascade = get_haar_cascade()

    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("Note: Local camera unavailable or running in headless/Colab mode.")
        print("For single image testing, use: python src/infer.py --image <path>")
        return

    print("=" * 60)
    print("Starting Real-Time Face Mask Detection (Press 'q' to exit)")
    print("=" * 60)

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        frame = process_frame(frame, model, face_cascade, eval_transform, device, threshold)
        cv2.imshow("Face Mask Detector", frame)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    run_face_mask_detector(threshold=0.19)